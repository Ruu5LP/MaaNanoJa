{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maananaja",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/privacy", "/terms", "/api/*", "/auth/*", "/healthz"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maananaja",
      "database_id": "7d464578-c801-4c19-8c34-1c1b3efbc4f0",
      "migrations_dir": "./migrations",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "ratelimits": [
    {
      "name": "ROOM_READ_RATE_LIMITER",
      "namespace_id": "2026081101",
      "simple": {
        "limit": 180,
        "period": 60,
      },
    },
    {
      "name": "ROOM_WRITE_RATE_LIMITER",
      "namespace_id": "2026081102",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "2026081103",
      "simple": {
        "limit": 20,
        "period": 60,
      },
    },
  ],
}
